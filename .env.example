# Copy this file to .env and fill in real values. Never commit .env.

# Local Postgres (used by docker-compose.yml and Prisma)
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hand_of_porsh
# 5433, not the default 5432, in case a native Postgres install already
# occupies 5432 on your machine
POSTGRES_PORT=5433

# Prisma connection string — must match the POSTGRES_* values above
DATABASE_URL="postgresql://changeme:changeme@localhost:5433/hand_of_porsh"

# Paystack secret key (test mode for local dev, live only in deployment).
# Get one from the Paystack dashboard under Settings > API Keys & Webhooks.
PAYSTACK_SECRET_KEY=sk_test_changeme

# Password for the single admin login at /admin/login. Also used to sign the
# admin session cookie — pick something long and random, not the site's public
# name or anything guessable.
ADMIN_PASSWORD=changeme
